# =============================================================================
# Desarrollo local (docker compose en la raíz) — tiene su propio Postgres.
# Producción Lyntrix: usá deploy/docker-compose.yml + variables DB_* abajo.
# =============================================================================

POSTGRES_USER=fuelops
POSTGRES_PASSWORD=fuelops_dev
POSTGRES_DB=fuelops
POSTGRES_PORT=5432

# --- Si ves: password authentication failed for user "fuelops" o "fueluser" ---
# 1) USUARIO: POSTGRES_USER solo se aplica la PRIMERA vez que se crea el volumen postgres_data.
# 2) CONTRASEÑA: cambiar POSTGRES_PASSWORD en .env NO actualiza Postgres si el volumen ya existe.
# 3) API viejo: docker compose up -d --force-recreate api
# En Docker local el API usa POSTGRES_HOST=fuelops_db.
# No uses $ en POSTGRES_PASSWORD sin escapar: en .env de compose, $VAR se interpreta como variable.

API_PORT=8000
FRONTEND_PORT=3000

# URL que usa el navegador para llamar al API (debe coincidir con el dominio público del backend).
# Local: http://localhost:8000
# Producción Irrigación Malargüe:
#   NEXT_PUBLIC_API_URL=https://api-tickets.irrigacionmalargue.net
NEXT_PUBLIC_API_URL=http://localhost:8000

# Orígenes CORS (coma). En producción:
#   CORS_ORIGINS=https://tickets.irrigacionmalargue.net
CORS_ORIGINS=

GOOGLE_API_KEY=
# Modelo con visión. gemini-2.0-flash-lite fue dado de baja.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Autenticación del panel admin ---
# Crear admin: ./scripts/create-admin.sh -u lautaro -g
# (en prod: docker compose -f deploy/docker-compose.yml exec api python -m app.cli.manage_admin …)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generá JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=720

# =============================================================================
# PRODUCCIÓN Lyntrix (Hetzner) — tickets.irrigacionmalargue.net
# =============================================================================
# 1) En postgres_core (una vez): editá y corré deploy/init-postgres_core.sql
# 2) Completá DB_* y DATABASE_URL (misma password que el SQL).
# 3) Pegá deploy/Caddyfile en el Caddy central y recargá.
# 4) Deploy:
#      docker compose -f deploy/docker-compose.yml --env-file .env up -d --build
#
# DB dedicada en postgres_core (sin servicio postgres en el compose del proyecto):
DB_USER=tickets_user
DB_PASSWORD=placeholder_seguro
DB_NAME=tickets_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres_core:5432/${DB_NAME}?schema=public

# Producción típica (descomentá / ajustá en el .env del servidor):
# NEXT_PUBLIC_API_URL=https://api-tickets.irrigacionmalargue.net
# CORS_ORIGINS=https://tickets.irrigacionmalargue.net
