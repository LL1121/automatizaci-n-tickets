# Fragmento para el Caddy CENTRAL de Lyntrix (red proxy_net).
# Los hostnames son los container_name de deploy/docker-compose.yml.
#
# DNS A/AAAA (ambos → IP del VPS Hetzner):
#   tickets.irrigacionmalargue.net
#   api-tickets.irrigacionmalargue.net
#
# Si antes usabas fuelops_web / fuelops_api, actualizá reverse_proxy a tickets_web / tickets_api.

tickets.irrigacionmalargue.net {
	encode gzip zstd
	reverse_proxy tickets_web:3000
}

api-tickets.irrigacionmalargue.net {
	encode gzip zstd
	reverse_proxy tickets_api:8000
}
