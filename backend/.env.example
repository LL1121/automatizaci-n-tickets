# Copiar a .env en desarrollo local (docker-compose usa variables del host o .env en la raíz del proyecto)
DATABASE_URL=postgresql://fuelops:fuelops_dev@localhost:5432/fuelops
GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.0-flash-lite
UPLOAD_DIR=./uploads

# Auth del panel admin (ver .env.example raíz). Sin estos valores el panel queda deshabilitado.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_MINUTES=720
